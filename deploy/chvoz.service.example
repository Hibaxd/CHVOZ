[Unit]
Description=CHVOZ e-shop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chvoz
Group=chvoz
WorkingDirectory=/opt/chvoz/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/chvoz/chvoz.env
ExecStartPre=/usr/bin/node server/production-check.mjs
ExecStart=/usr/bin/node server/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/chvoz
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
