# Zóny patří do bloku `http {}` v /etc/nginx/nginx.conf.
limit_req_zone $binary_remote_addr zone=chvoz_global:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=chvoz_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=chvoz_checkout:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=chvoz_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name chvoz.cz www.chvoz.cz;
    return 301 https://chvoz.cz$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.chvoz.cz;
    ssl_certificate /etc/letsencrypt/live/chvoz.cz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chvoz.cz/privkey.pem;
    return 301 https://chvoz.cz$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name chvoz.cz;

    ssl_certificate /etc/letsencrypt/live/chvoz.cz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chvoz.cz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:CHVOZ_TLS:10m;
    ssl_session_tickets off;

    client_max_body_size 18m;
    client_body_timeout 15s;
    keepalive_timeout 15s;
    send_timeout 30s;
    limit_conn chvoz_conn 30;
    limit_req zone=chvoz_global burst=40 nodelay;

    gzip on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    location = /api/auth/login {
        limit_req zone=chvoz_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8787;
        include /etc/nginx/snippets/chvoz-proxy.conf;
    }

    location = /api/auth/register {
        limit_req zone=chvoz_auth burst=3 nodelay;
        proxy_pass http://127.0.0.1:8787;
        include /etc/nginx/snippets/chvoz-proxy.conf;
    }

    location = /api/orders {
        limit_req zone=chvoz_checkout burst=2 nodelay;
        proxy_pass http://127.0.0.1:8787;
        include /etc/nginx/snippets/chvoz-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        include /etc/nginx/snippets/chvoz-proxy.conf;
    }
}

