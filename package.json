{
  "name": "chvoz-store",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch server/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/server.mjs",
    "typecheck": "tsc -b --pretty false",
    "test:backend": "node server/smoke-test.mjs",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test:backend",
    "bootstrap:production": "node server/bootstrap-production.mjs",
    "check:production": "node server/production-check.mjs",
    "audit:prod": "pnpm audit --prod"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
