# Serverový admin. Nikdy nepoužívejte prefix VITE_ pro tajné hodnoty.
CHVOZ_ADMIN_USERNAME=Hiba
CHVOZ_ADMIN_EMAIL=admin@example.cz
# Použij jen při jednorázovém `bootstrap:production`. Server heslo uloží jako
# salted scrypt hash; potom tento řádek ze serverových secrets odstraň.
CHVOZ_ADMIN_PASSWORD=jednorazove_velmi_dlouhe_nove_heslo

# Účet, který server vrátí pouze k objednávce s bankovním převodem.
CHVOZ_BANK_ACCOUNT=123456789/0100

# Produkční nastavení upravte podle skutečné domény a datového disku.
CHVOZ_PUBLIC_URL=https://chvoz.cz
CHVOZ_ALLOWED_ORIGINS=https://chvoz.cz
CHVOZ_HOST=127.0.0.1
CHVOZ_PORT=8787
CHVOZ_DATA_DIR=/var/lib/chvoz
CHVOZ_TRUST_PROXY=true
CHVOZ_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
CHVOZ_UPLOAD_QUOTA_BYTES=2147483648
CHVOZ_UPLOAD_MIN_FREE_BYTES=536870912

# Povinná ochrana registrace a checkoutu v produkci.
CHVOZ_REQUIRE_BOT_CHECK=true
CHVOZ_TURNSTILE_SITE_KEY=verejny_site_key
CHVOZ_TURNSTILE_SECRET_KEY=tajny_secret_key
